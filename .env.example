# Copy this file to .env and adjust if needed. .env is git-ignored.

# PostgreSQL connection (matches docker-compose.yml defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fantasy
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=fantasy

# Download behaviour (data comes from nflverse through the GitHub API)
# Seconds to wait between requests: polite, and well under GitHub's limit of
# 60 unauthenticated API requests per hour for normal use (a season load is ~6).
# Keep the User-Agent honest: it tells the server who is asking.
SCRAPER_DELAY_SECONDS=4
SCRAPER_USER_AGENT=ffdata-learning-project/0.1 (personal educational use)
RAW_DATA_DIR=data/raw
